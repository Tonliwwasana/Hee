<!DOCTYPE html>
<html>
    <html lang="th">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title> คาเฟ่ ณ พลับพลา </title>
        <meta name="description" content="คาเฟ่ ณ พลับพลา – คาเฟ่สวย อยู่ถนนจักรวรรดิ กรุงเทพมหานคร" />
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">

        <style>
            :root{
                --bg: #fff8f2;
                --accent: #8B5E3C; /* Mocha */
                --accent-2: #F2C078 /* Warm */
                --muted: #6b6b6b;
                --card: #ffffff;
                --glass: rgba(255, 255, 255, 0.7);
            }

            *{box-sizing:border-box}
            body{
                font-family: 'Montserrat', system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', 'Helvetica Neue', Arial; 
                margin:0; 
                background:linear-gradient(180deg,var(--bg),#fff); 
                color:#222;
            }

            /* Top nav / hero */
            .nav{
                display:flex;
                justify-content:space-between;
                align-items:center;
                padding:18px 32px;
                position:fixed;
                left:0;
                right:0;
                top:0;
                z-index:40;
                background:linear-gradient(180deg, rgba(255,255,255,0.85), rgba(255,255,255,0.6));
                backdrop-filter: blur(6px);box-shadow:0 6px 18px rgba(0,0,0,0.06);
            }

            .brand{
                display:flex;
                align-items:center;
                gap:14px;
            }

            .logo{
                width:56px;
                height:56px;
                border-radius:12px;
                overflow:hidden;
                box-shadow:0 6px 18px rgba(139,94,60,0.12);
                display:flex;
                align-items:center;
                justify-content:center;
                background:linear-gradient(135deg,var(--accent),var(--accent-2));
                color:white;font-weight:700;
            }

            .brand h1{
                margin:0;
                font-size:18px;
            }

            .brand p{
                margin:0;
                font-size:12px;
                color:var(--muted);
            }
            
            .nav .menu{
                display:flex;
                gap:22px;
                align-items:center;
            }

            .nav a{
                color:var(--muted);
                text-decoration:none;
                font-weight:600;
            }

            .cta{
                background:var(--accent);
                color:white;
                padding:10px 14px;
                border-radius:10px;
                text-decoration:none;
                font-weight:700;
            }

            .socials a{
                display:inline-block;
                padding:8px 14px;
                border:1px solid var(--accent);
                border-radius:10px;
                text-decoration:none;
                color:var(--accent);
                transition:0.3s;
            }

            .socials a:hover{
                background:var(--accent);
                color:white;
                border-color:var(--accent);
            }

            .hero{
                height:72vh;
                min-height:420px;
                border-bottom-left-radius:36px;
                border-bottom-right-radius:36px;
                overflow:hidden;
                position:relative;
                margin-top:70px;
            }

            .hero .media{
                position:absolute;
                inset:0;
                background-image: url('https://images.unsplash.com/photo-1504754524776-8f4f37790ca0?q=80&w=1600&auto=format&fit=crop&ixlib=rb-4.0.3&s=2a1b2b6f6d3c8b2b6a5b9c8b6f7a8f3a');
                background-size:cover;
                background-position:center;
                filter:contrast(1.05) saturate(1.05);
            }

            .hero .overlay{
                position:absolute;
                inset:0;
                background:linear-gradient(180deg, rgba(11,6,5,0.1), rgba(255,255,255,0.18));
            }

            .hero .hero-content{
                position:relative;
                z-index:2;
                max-width:1100px;
                margin:0 auto;
                padding:48px;
                color:#1b120f;
                display:grid;
                grid-template-columns: 1fr 380px;
                gap:24px;align-items:center;
            }

            .hero h2{
                font-size:36px;
                margin:0 0 8px;
            }

            .hero p.lead{
                margin:0 0 18px;
                color: #3b2e29;
            }

            .hero .shop-card{
                background:var(--card);
                padding:18px;
                border-radius:16px;
                box-shadow:0 10px 30px rgba(0,0,0,0.08);
            }

            .price{
                display:flex;
                align-items:
                center;gap:10px;
            }

            .price .big{
                font-size:22px;
                font-weight:800;
                color:var(--accent);
            }

            /* sections */
            .container{
                max-width:1100px;
                margin:36px auto;
                padding:0 20px;
            }

            .section-title{
                display:flex;
                justify-content:space-between;
                align-items:center;
                margin-bottom:14px;
            }

            .grid{
                display:grid;
                grid-template-columns:repeat(3,1fr);
                gap:18px;
            }

            .card{
                background:var(--card);
                padding:18px;
                border-radius:12px;
                box-shadow:0 8px 24px rgba(0,0,0,0.06);
            }

            .menu-item{
                display:flex;
                gap:12px;
                align-items:center;
            }

            .menu-item img{
                width:80px;
                height:60px;
                object-fit:cover;
                border-radius:8px;
            }

            .muted{
                color:var(--muted);
            }

            /* gallery */
            .gallery{
                display:grid;
                grid-template-columns: repeat(4,1fr);
                gap:10px;
            }

            .gallery img{
                width:100%;
                height:180px;
                object-fit:cover;
                border-radius:10px;
            }

            /* footer */
            footer{
                background:linear-gradient(180deg,#fff,#fff8f2);
                padding:36px 20px;
                margin-top:30px;
                border-top:1px solid rgba(0,0,0,0.04);
            }

            .footer-grid{
                display:grid;
                grid-template-columns: 1fr 1fr;
                gap:18px;
                max-width:1100px;
                margin:0 auto;
            }

            .socials{
                display:flex;
                gap:10px;
            }

            /* responsive */
            @media (max-width:980px){
            .hero .hero-content{
                grid-template-columns:1fr; 
                padding:28px;
            }

            .grid{grid-template-columns:repeat(2,1fr);}

            .gallery{grid-template-columns:repeat(2,1fr)}
            }

            @media (max-width:640px){
                .nav{padding:12px 16px}
                .logo{width:44px;height:44px}
                .grid{grid-template-columns:1fr}
                .gallery img{height:120px}
                .hero{height:auto}
                .hero h2{font-size:26px}
            }


            /* small animations */
            .fade-in{
                opacity:0;
                transform:translateY(18px);
                transition:all 600ms cubic-bezier(.2,.9,.3,1);
            }

            .fade-in.show{
                opacity:1;
                transform:none;
            }

            .btn{
                display:inline-block;
                padding:10px 14px;
                border-radius:10px;
                text-decoration:none;
            }
        </style>
    </head>

        <body>
            <header class="nav">
            <div class="brand">
                <!-- ใส่รูป Logo ร้าน --> 
            <div class="logo"> พลับพลา </div>
                <div>
                    <h1>คาเฟ่ ณ พลับพลา</h1>
                    <p>กาแฟสด • เบเกอรี่ • บรรยากาศอบอุ่น</p>
                </div>
            </div>

            <nav class="menu">
                <a href="#menu">Menu</a>
                <a href="#gallery">Gallery</a>
                <a href="#contact">Contact</a>
                <a class="cta" href="#visit">Visited</a>
            </nav>
            </header>

            <section class="hero" aria-label="Hero">
                <div class="media" aria-hidden="true"></div>
                <div class="overlay" aria-hidden="true"></div>
                <div class="hero-content container">
                <div>
                    <h2>ยินดีต้อนรับสู่ "คาเฟ่ ณ พลับพลา"</h2>
                    <p class="lead">คาเฟ่บรรยากาศอบอุ่น ตกแต่งสไตล์โมเดิร์น-วินเทจ เสิร์ฟกาแฟคั่วสด เบเกอรี่อบใหม่ทุกวันเหมาะสำหรับนั่งทำงาน พูดคุย พบปะเพื่อน</p>
                    <div style="display:flex;gap:12px;align-items:center">
                        <a class="btn" href="#menu">ดูเมนู</a>
                    </div>
                    <div style="margin-top:18px;display:flex;gap:12px;align-items:center">
                        <div style="background:var(--glass);padding:12px;border-radius:12px">⏰ เปิดทุกวัน 07:00 - 18:00</div>
                        <div style="background:var(--glass);padding:12px;border-radius:12px">📍 ข้างมหาวิทยาลัยชื่อดัง — พลับพลาจักรวรรดิ</div>
                    </div>
                </div>

            <aside class="shop-card fade-in" id="visit">
                <h3 style="margin:0 0 6px">Promotion Today ❗❗</h3>
                <p class="muted" style="margin:0 0 12px">ซื้อกาแฟ 1 แก้ว แถมบรูกกี้ 1 ชิ้น (วันนี้เท่านั้น) ❗</p>
                    <div style="display:flex;justify-content:space-between;align-items:center">
                        <div>
                            <div class="price"><div class="big">฿79</div><div class="muted">/ เริ่มต้น</div></div>
                            <p class="muted" style="margin-top:6px">เมล็ดกาแฟคั่วกลางจากไร่ในประเทศ</p>
                        </div>
                        <div>
                            <img src="https://images.unsplash.com/photo-1509042239860-f550ce710b93?q=80&w=600&auto=format&fit=crop&ixlib=rb-4.0.3&s=2b8f3e8a9d9c" alt="กาแฟ" style="width:120px;border-radius:10px;object-fit:cover;">
                        </div>
                    </div>
                    <div style="margin-top:12px;display:flex;gap:8px">
                        <a class="btn" href="#contact">สอบถาม</a>
                        <a class="btn cta" href="#menu">สั่งออนไลน์</a>
                    </div>
            </aside>
            </div>
            </section>

            <main>
                <section class="container" id="menu">
                    <div class="section-title">
                        <h3>เมนูแนะนำ</h3>
                        <p class="muted">กาแฟ & เบเกอรี่</p>
                    </div>

                <div class="grid">
                    <article class="card fade-in">
                    <div class="menu-item">
                    <img src="https://images.unsplash.com/photo-1509042239860-f550ce710b93?q=80&w=800&auto=format&fit=crop&ixlib=rb-4.0.3&s=2b8f3e8a9d9c" alt="ลาเต้">
                        <div>
                            <h4 style="margin:0">ลาเต้ครีม</h4>
                            <p class="muted" style="margin:6px 0 0">กาแฟลาเต้ รสนุ่ม ครีมเนียน — ฿60</p>
                        </div>
                    </div>
                    </article>

                <article class="card fade-in">
                    <div class="menu-item">
                    <img src="https://images.unsplash.com/photo-1541167760496-1628856ab772?q=80&w=800&auto=format&fit=crop&ixlib=rb-4.0.3&s=3c4b5b6a7d8a" alt="กาแฟดำ">
                        <div>
                            <h4 style="margin:0">อเมริกาโน่</h4>
                            <p class="muted" style="margin:6px 0 0">เข้มข้น สดชื่น — ฿55</p>
                        </div>
                    </div>
                </article>
            
                <article class="card fade-in">
                    <div class="menu-item">
                    <img src="Frenchfried.jpg" alt="เฟรนส์ฟราย">
                        <div>
                            <h4 style="margin:0">เฟรนส์ฟราย</h4>
                            <p class="muted" style="margin:6px 0 0">ทอดใหม่ กรอบอร่อย ไม่อมน้ำมัน — ฿40</p>
                        </div>
                    </div>
                </article>

                </div>
                </section>

                <section class="container" id="gallery" style="margin-top:18px">
                <div class="section-title">
                    <h3>Gallery</h3>
                    <p class="muted">บรรยากาศภายในร้าน</p>
                </div>

                <div class="gallery fade-in">
                    <img src="Food.jpg" alt="อาหาร">
                    <img src="Fruit.jpg" alt="ผลไม้">
                    <img src="Dessert.jpg" alt="ขนมหวาน1">
                    <img src="Dessert2.jpg" alt="ขนมหวาน2">
                </div>
                </section>

                <section class="container" style="margin-top:28px">
                <div class="section-title">
                    <h3>รีวิวจากลูกค้า</h3>
                    <p class="muted">เสียงตอบรับจริง</p>
                </div>

                <div class="grid">
                    <div class="card fade-in">
                        <strong>คุณมิ้นท์</strong>
                        <p class="muted">"กาแฟหอม บรรยากาศดีมาก เหมาะกับการทำงาน"</p>
                    </div>

                    <div class="card fade-in">
                        <strong>คุณต้น</strong>
                        <p class="muted">"เค้กอร่อยมาก พนักงานบริการดี"</p>
                    </div>

                    <div class="card fade-in">
                        <strong>คุณฟ้า</strong>
                        <p class="muted">"มีมุมถ่ายรูปสวย ๆ เยอะเลย"</p>
                    </div>
                </div>
                </section>

                <section class="container" id="contact" style="margin-top:28px;margin-bottom:18px">
                <div class="section-title">
                    <h3>ติดต่อ / แผนที่</h3>
                    <p class="muted">มาพบกันได้ที่ร้าน</p>
                </div>

                <div class="card fade-in">
                <div style="display:flex;flex-wrap:wrap;gap:18px;align-items:center">
                <div style="flex:1;min-width:260px">
                        <p style="margin:0"><strong>ที่อยู่ :</strong> ถนน จักรวรรดิ แขวงจักรวรรดิ์ เขตสัมพันธวงศ์ กรุงเทพมหานคร 10100 </p>
                        <p style="margin:6px 0"><strong>เวลาเปิด-ปิด :</strong> ทุกวัน 07:00 - 18:00</p>
                        <p style="margin:6px 0"><strong>โทร :</strong> 093-668-9365</p>
                    <div style="margin-top:10px" class="socials">
                        <a href="https://www.facebook.com/atplubpla">Facebook</a>
                    </div>
                </div>

                <div style="flex:1;min-width:260px">
                    <!-- simple interactive map placeholder (no external API keys) -->
                    <div style="border-radius:10px;overflow:hidden;border:1px solid rgba(0,0,0,0.06)">
                        <img src="SitHere.jpg" alt="map placeholder" style="width:100%;height:240px;object-fit:cover">
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

    <footer>
    <div class="footer-grid">
        <div>
            <h4 style="margin:0">คาเฟ่ ณ พลับพลา</h4>
            <p class="muted" style="margin-top:6px">กาแฟคุณภาพ บริการเป็นกันเอง</p>
        </div>
        <div style="text-align:right">
            <p class="muted">© <span id="year"></span>คาเฟ่ ณ พลับพลา</p>
            <p class="muted">Designed with ♥</p>
        </div>
    </div>
</footer>

    <script>
        // small JS for interactions
    document.getElementById('year').textContent = new Date().getFullYear();

        // reveal on scroll
    const faders = document.querySelectorAll('.fade-in');
    const obs = new IntersectionObserver((entries) =>{
        entries.forEach(e=>{
        if(e.isIntersecting){ e.target.classList.add('show'); obs.unobserve(e.target); 
        }
      })
    }, {threshold:0.12});
    faders.forEach(f=> obs.observe(f));

        // smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(a=>{
        a.addEventListener('click', (e)=>{
            const href = a.getAttribute('href');
            if(href.length>1){
                e.preventDefault();
                document.querySelector(href).scrollIntoView({behavior:'smooth',block:'start'});
            }
        })
    });

        // small mobile nav fallback: collapse menu into simple toggle (optional)
        // (Not implemented here to keep HTML simple—can add if you want.)
    </script>
    </body>
</html>
